      "scene": "temple_court",
      "camera": "crane_up",
      "camera_strength": 0.1,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "host",
      "text": "编钟出土时，钟架仍然屹立，仿佛刚刚演奏完。",
      "characters": [
        "host"
      ],
      "broll": false
    },
    {
      "id": "act42",
      "name": "第 42 幕",
      "scene": "archive_vault",
      "camera": "rack_focus",
      "camera_strength": 0.08,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "figure_a",
      "text": "六十五件钟，没有一件是多余的。",
      "characters": [
        "figure_a"
      ],
      "broll": false
    },
    {
      "id": "act43",
      "name": "第 43 幕",
      "scene": "temple_court",
      "camera": "push_in",
      "camera_strength": 0.1,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "host",
      "text": "先民把音乐，铸进了青铜里。",
      "characters": [
        "host"
      ],
      "broll": false
    },
    {
      "id": "act44",
