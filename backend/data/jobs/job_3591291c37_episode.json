      "no": 8,
      "type": "shot_reverse",
      "duration": 3.67,
      "speaker": "asset_18cd292c6a",
      "speaker_name": "大魏",
      "line": "三块七？我一场灯光的电费都不止这个数。",
      "visual": "大魏 · 中景",
      "lower_third": null,
      "punchline": "",
      "sfx": "",
      "mood": "",
      "title": null,
      "subtitle": null
    },
