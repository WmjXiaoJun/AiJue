      "camera": "dolly",
      "camera_strength": 0.08,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "figure_a",
      "text": "你看那剑锋上的一道细痕，也许是某次出征留下的。",
      "characters": [
        "figure_a"
      ],
      "broll": false
    },
