  "action_library": [
    {
      "id": "tie_apron",
      "h3_prompt": "Subject ties on a linen apron at the stove and rolls up their sleeves",
      "prop": "apron"
    },
    {
      "id": "chop_veg",
      "h3_prompt": "Subject chops vegetables on the counter with a steady clay-mation rhythm",
      "prop": "vegetables"
    },
    {
      "id": "stir_wok",
      "h3_prompt": "Subject stirs the wok, steam curling up in the warm kitchen light",
      "prop": "wok"
    },
    {
      "id": "taste_soup",
      "h3_prompt": "Subject lifts a spoon, tastes the soup and nods to themselves",
      "prop": null
    },
    {
      "id": "plate_dish",
      "h3_prompt": "Subject slides the finished dish onto a plate",
      "prop": "plate"
    },
    {
      "id": "serve_table",
      "h3_prompt": "Subject carries the plate to the dining table and sets it down",
      "prop": "plate"
    },
    {
      "id": "sit_eat",
      "h3_prompt": "Subject sits down opposite the guest and picks up chopsticks",
      "prop": null
    },
    {
      "id": "pour_tea",
      "h3_prompt": "Subject pours tea from the kettle into two small cups",
      "prop": "kettle"
    },
    {
      "id": "wipe_hands",
      "h3_prompt": "Subject wipes their hands on the apron and looks around the tidy kitchen",
      "prop": null
    }
  ],
  "segments": [
