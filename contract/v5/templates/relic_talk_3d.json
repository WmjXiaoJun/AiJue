      "broll": false
    },
    {
      "id": "act31",
      "name": "第 31 幕",
      "scene": "temple_court",
      "camera": "orbit",
      "camera_strength": 0.08,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "host",
      "text": "当钟声响起，我们听见的不只是音乐，是一个时代的秩序。",
      "characters": [
        "host"
      ],
      "broll": false
    },
    {
      "id": "act32",
      "name": "第 32 幕",
      "scene": "temple_court",
      "camera": "static",
      "camera_strength": 0.06,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "figure_a",
      "text": "礼乐文明，就在这金声玉振之间。",
      "characters": [
        "figure_a"
      ],
      "broll": false
    },
