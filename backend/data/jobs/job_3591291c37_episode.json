      "segment": "正片",
      "segment_id": "正片",
      "no": 9,
      "type": "shot_reverse",
      "duration": 4.97,
      "speaker": "asset_e8bb8ee62a",
      "speaker_name": "阿栗",
      "line": "所以我说，便宜不是重点，重点是它敢想一些人类不敢想的环节。",
