      "camera": "pan_left",
      "camera_strength": 0.08,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "host",
      "text": "青铜会生锈，纸张会发黄，但它们记录的心气不会。",
      "characters": [
        "host"
      ],
      "broll": false
    },
    {
      "id": "act49",
      "name": "第 49 幕",
      "scene": "great_wall",
      "camera": "crane_up",
      "camera_strength": 0.1,
      "duration": 6.5,
