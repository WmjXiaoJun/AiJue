      "scene": "museum_hall",
      "camera": "pan_right",
      "camera_strength": 0.08,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "figure_a",
      "text": "它们见过盛世，也见过离乱。",
      "characters": [
        "host",
        "figure_a"
      ],
      "broll": false
    },
    {
      "id": "act45",
      "name": "第 45 幕",
      "scene": "museum_hall",
      "camera": "dolly_zoom",
      "camera_strength": 0.1,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "host",
      "text": "今天，它们只看着我们。",
      "characters": [
        "host"
      ],
      "broll": false
    },
    {
      "id": "act46",
      "name": "第 46 幕",
      "scene": "display_case",
      "camera": "rack_focus",
      "camera_strength": 0.08,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "host",
      "text": "文物不会说话，但它们从不说谎。",
      "characters": [
        "host"
      ],
      "broll": false
    },
    {
