      "shots": [
        {
          "intent": "host_close",
          "size": "Medium Close-up",
          "angle": "eye-level",
          "movement": "slow dolly-in",
          "action": "turn_to_camera",
          "props": [],
          "h3_mode": "audio_ref"
        },
        {
          "intent": "outro",
          "size": "Wide",
          "angle": "high-angle",
          "movement": "static",
          "action": "stand_desk",
          "props": [],
          "h3_mode": "fl2v"
        }
      ]
    }
  ],
  "camera_language": {
    "default": "slow dolly-in",
    "wide": "truck left",
    "reaction": "static",
    "close": "slow push-in"
  },
  "packaging": {
    "lower_third": "zaopianju_yellow",
    "transition": "fade",
    "bgm": "talk_light",
    "subtitle_style": "variety"
  },
  "audio": {
