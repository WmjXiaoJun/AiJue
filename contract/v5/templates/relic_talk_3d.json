        "figure_a"
      ],
      "broll": false
    },
    {
      "id": "act27",
      "name": "第 27 幕",
      "scene": "temple_court",
      "camera": "tilt_up",
      "camera_strength": 0.08,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "host",
      "text": "一钟双音，敲击正鼓和侧鼓，能发出两个不同的音。",
      "characters": [
        "host"
      ],
      "broll": false
    },
    {
      "id": "act28",
      "name": "第 28 幕",
      "scene": "temple_court",
      "camera": "push_in",
      "camera_strength": 0.1,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "figure_a",
      "text": "十二律俱全，音域跨五个半八度，今天仍能演奏。",
      "characters": [
        "figure_a"
      ],
      "broll": false
    },
    {
      "id": "act29",
      "name": "第 29 幕",
      "scene": "candle_gallery",
      "camera": "pan_left",
      "camera_strength": 0.08,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "host",
      "text": "两千四百年前的乐师，已经能演奏出完整的交响。",
      "characters": [
        "host"
      ],
      "broll": false
    },
    {
      "id": "act30",
      "name": "第 30 幕",
      "scene": "archive_vault",
      "camera": "rack_focus",
      "camera_strength": 0.08,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "figure_a",
      "text": "钟体上的铭文，记录着曾楚两国的礼乐往来。",
