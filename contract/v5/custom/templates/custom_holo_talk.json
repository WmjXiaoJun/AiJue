{
  "id": "custom_holo_talk",
  "label": "全息史料夜话（示例）",
  "description": "示例自定义模板：引用 custom_holo_paper 风格 + laozhou 角色 + custom_holo_gallery 场景，展示模板/acts 写法。",
  "tags": ["custom", "example"],
  "style": "custom_holo_paper",
  "target_duration": 30,
  "aspect": [16, 9],
  "cast": [
    { "role": "host", "character": "laozhou", "wardrobe": "hanfu_jacket" }
  ],
  "acts": [
    {
      "id": "cold_open",
      "label": "开场",
      "duration": 12,
      "scene": "custom_holo_gallery",
      "camera": "slow_push",
      "camera_zone": "wide",
      "line": "host",
      "beats": ["全息画廊亮起", "host 转身面向镜头"],
      "characters": ["host"],
      "transition": "ink_wipe"
    },
    {
      "id": "detail",
      "label": "史料特写",
      "duration": 10,
      "scene": "custom_holo_gallery",
      "camera": "pan_right",
      "camera_zone": "detail",
      "line": "",
      "beats": ["镜头扫过地形等高线"],
      "transition": "fade"
    },
    {
      "id": "close",
      "label": "收束",
      "duration": 8,
      "scene": "custom_holo_gallery",
      "camera": "static",
      "camera_zone": "host_close",
      "line": "host",
      "beats": ["host 收束观点"]
    }
  ],
  "packaging": {
    "subtitle": "holo_seal",
    "transition": "ink_wipe",
    "title": "全息史料夜话",
    "lower_third": "ink_seal_cyan"
  },
  "format": "talk_show"
}
