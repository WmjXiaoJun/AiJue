          "movement": "tracking",
          "action": "walk_to_sofa",
          "props": [],
          "h3_mode": "fl2v",
          "camera_zone": "sofa_ots"
        },
        {
          "intent": "host_guest_reverse",
          "size": "Medium Close-up",
          "angle": "eye-level",
          "movement": "static",
          "action": "turn_to_guest",
          "props": [],
          "h3_mode": "audio_ref",
          "camera_zone": "sofa_ots"
        }
      ]
    },
    {
