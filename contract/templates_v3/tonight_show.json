        {
          "intent": "reaction",
          "size": "Close-up",
          "angle": "low-angle",
          "movement": "static",
          "action": "react_laugh",
          "props": [],
          "h3_mode": "fl2v",
          "camera_zone": "front"
        },
        {
          "intent": "handoff",
          "size": "Medium",
          "angle": "eye-level",
          "movement": "pan",
          "action": "handoff_script",
          "props": [
            "script"
          ],
          "h3_mode": "audio_ref",
          "camera_zone": "desk_swap"
        }
      ]
