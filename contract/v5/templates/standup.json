      "id": "act06",
      "name": "第 6 幕",
      "scene": "dressing_room_vhs",
      "camera": "push_in",
      "camera_strength": 0.1,
      "duration": 6.4,
      "line": "host",
      "text": "那可不一定，没电了得找充电宝，还得担心别人给你发信息。",
      "characters": [
        "host",
        "figure_a"
      ],
      "broll": false
