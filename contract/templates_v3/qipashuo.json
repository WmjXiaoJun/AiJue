          "intent": "affirm_rise",
          "size": "Wide",
          "angle": "eye-level",
          "movement": "slow push-in",
          "action": "stand_affirm",
          "props": [],
          "h3_mode": "fl2v",
          "camera_zone": "split_wide"
        },
        {
          "intent": "gavel_open",
          "size": "Medium",
          "angle": "eye-level",
          "movement": "static",
          "action": "strike_desk",
          "props": [
            "gavel"
          ],
          "h3_mode": "audio_ref",
          "camera_zone": "front"
        }
      ]
    },
    {
      "id": "affirm",
      "name": "正方陈词",
      "duration": 70,
