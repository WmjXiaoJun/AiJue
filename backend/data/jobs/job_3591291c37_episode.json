      "episode_id": "ep_e1015494fa",
      "segment": "正片",
      "segment_id": "正片",
      "no": 7,
      "type": "shot_reverse",
      "duration": 5.23,
      "speaker": "asset_e8bb8ee62a",
      "speaker_name": "阿栗",
      "line": "我让 AI 生成了一整期访谈，嘉宾、灯光、笑声全都有，成本三块七。",
      "visual": "阿栗 · 中景",
      "lower_third": null,
      "punchline": "",
      "sfx": "",
      "mood": "",
      "title": null,
      "subtitle": null
