      "scene": "great_wall",
      "camera": "truck_right",
      "camera_strength": 0.1,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "host",
      "text": "画中的每一棵树，都有不同的姿态。",
      "characters": [
        "host"
      ],
      "broll": false
    },
    {
      "id": "act39",
      "name": "第 39 幕",
      "scene": "scroll_split",
      "camera": "pan_left",
      "camera_strength": 0.08,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "figure_b",
      "text": "青绿之间，藏着北宋人对山水的全部想象。",
      "characters": [
        "figure_b"
      ],
      "broll": false
    },
    {
      "id": "act40",
      "name": "第 40 幕",
      "scene": "candle_gallery",
      "camera": "push_in",
      "camera_strength": 0.1,
      "duration": 6.5,
      "duration_hint": 6.5,
      "line": "figure_a",
      "text": "十八岁，半年，十一米，一生一次。",
      "characters": [
        "figure_a"
      ],
      "broll": false
    },
    {
      "id": "act41",
