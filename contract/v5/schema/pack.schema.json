{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaopianju.local/contract/v5/schema/pack.schema.json",
  "title": "V5 pack（风格包 / 内容包）",
  "description": "把风格、场景、角色、道具、模板打包成可整体挑选的集合；数组元素是对应目录的对象 id（校验器检查引用存在）。",
  "type": "object",
  "required": ["id", "label"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "styles": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "scenes": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "characters": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "props": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "templates": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "cover": { "type": "string", "description": "可选：封面图路径（相对仓库根）" }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,60}$"
    }
  }
}
