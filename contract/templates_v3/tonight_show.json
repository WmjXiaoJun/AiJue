{
  "id": "tonight_show",
  "label": "美式深夜秀",
  "style": "cinematic_3d",
  "aspect": "16:9",
  "target_duration": 300,
  "stage": {
    "type": "3d_set",
    "plate": "late_night_desk__cinematic",
    "scene_desc": "A neon-lit late-night talk show studio: a dark polished wooden desk in the foreground with two black leather chairs behind it, a floor-to-ceiling wall of glowing cyan neon panels, a glossy reflective stage floor, cool teal rim light and warm practical lamps on the desk.",
    "layout": {
      "desk": [
        0.3,
        0.62
      ],
      "sofa": [
        0.7,
        0.6
      ],
      "window": [
        0.5,
        0.18
      ],
      "guest_a": [
        0.63,
        0.6
      ],
      "guest_b": [
        0.77,
        0.6
      ],
      "ground_y": 0.86
    },
    "props": [
      {
        "id": "cue_cards",
        "zone": "desk",
        "interaction": "pick"
      },
      {
        "id": "coffee_mug",
        "zone": "desk",
        "interaction": "sip"
      },
      {
        "id": "monitor",
        "zone": "desk",
        "interaction": "look"
      },
      {
        "id": "script",
        "zone": "sofa",
        "interaction": "handoff"
      }
    ],
    "camera_zones": [
      "front",
      "desk_swap",
      "sofa_ots",
      "window_wide",
      "guest_close"
    ]
  },
  "cast": [
    {
      "role": "host",
      "character": "laozhou",
      "block": "desk",
      "props": [
        "cue_cards"
      ],
      "wardrobe": "navy_suit"
    },
    {
      "role": "guest_a",
      "character": "ali",
      "block": "guest_a",
      "props": [
        "coffee_mug"
      ],
      "wardrobe": "purple_hoodie"
    },
    {
      "role": "guest_b",
      "character": "dawei",
      "block": "guest_b",
      "props": [
        "script"
      ],
      "wardrobe": "charcoal_suit"
    }
  ],
  "action_library": [
    {
      "id": "walk_in_desk",
      "h3_prompt": "Subject walks from the window toward the desk, pulls out the chair and sits down while smoothing the suit jacket",
      "prop": null
    },
    {
      "id": "pick_cue_cards",
      "h3_prompt": "Subject picks up the cue cards from the desk and flips through them while talking to camera",
      "prop": "cue_cards"
    },
    {
      "id": "walk_to_sofa",
      "h3_prompt": "Subject walks in from the side of the stage and settles onto the guest sofa, greeting the host",
      "prop": null
    },
    {
      "id": "turn_to_guest",
      "h3_prompt": "Subject turns from the camera toward the guest on the sofa and raises an eyebrow",
      "prop": null
    },
    {
      "id": "sip_mug",
      "h3_prompt": "Subject lifts the coffee mug, takes a sip and sets it back on the desk",
      "prop": "coffee_mug"
    },
    {
      "id": "react_laugh",
      "h3_prompt": "Subject laughs and slaps the desk lightly, then points at the guest",
      "prop": null
    },
    {
      "id": "handoff_script",
      "h3_prompt": "Subject hands a folded script across the desk to the guest beside them",
      "prop": "script"
    },
    {
      "id": "point_window",
      "h3_prompt": "Subject turns and points toward the city window while delivering a punchline",
      "prop": null
    },
    {
      "id": "turn_to_camera",
      "h3_prompt": "Subject turns back to the camera, leans on the desk and delivers the closing line",
      "prop": null
    }
  ],
  "segments": [
    {
      "id": "cold_open",
      "name": "开场独白",
      "duration": 35,
      "beats": [
        "host 从窗边走向 desk",
        "host 拿起 cue cards 对镜头开场",
        "host 指向窗外城市夜景"
      ],
      "shots": [
        {
          "intent": "establishing",
          "size": "Wide",
          "angle": "eye-level",
          "movement": "truck left",
          "action": "walk_in_desk",
          "props": [],
          "h3_mode": "fl2v",
          "camera_zone": "window_wide"
        },
        {
          "intent": "host_dialogue",
          "size": "Medium",
          "angle": "eye-level",
          "movement": "slow dolly-in",
          "action": "pick_cue_cards",
          "props": [
            "cue_cards"
          ],
          "h3_mode": "audio_ref",
          "camera_zone": "front"
        }
      ]
    },
    {
      "id": "guest_intro",
      "name": "嘉宾入场",
      "duration": 55,
      "beats": [
        "guest 从侧幕走进",
